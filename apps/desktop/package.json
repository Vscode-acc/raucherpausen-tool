{
  "name": "@raucherpausen/desktop",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json -w\" \"wait-on dist/main.js http://localhost:5173 && electron .\"",
    "dev:debug": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json -w\" \"wait-on dist/main.js http://localhost:5173 && electron . -dev\"",
    "build": "tsc -p tsconfig.main.json && vite build --outDir dist-renderer",
    "lint": "eslint .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "gifuct-js": "^2.1.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.34.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  }
}

